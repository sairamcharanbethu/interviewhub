OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SKILLS_DIR=
DATA_DIR=./data
# NATIVELY_SKILLS_DIR: absolute path of Natively's local Skills directory,
# for automatic Skill installation (Install to Natively). Leave unset on
# macOS to use the verified default ~/Library/Application Support/Natively/skills
# (only used when Natively is actually installed — the app verifies the
# directory at runtime and blocks installation when it cannot be verified).
# Manual export (SKILLS_DIR, default data/skills/) always keeps working.
NATIVELY_SKILLS_DIR=

# --- InterviewHub security (no real values here — ever) ---
# INTERVIEWHUB_SECRET: >= 32 chars. When set, it is the AES-256-GCM key
# (SHA-256-derived) that encrypts the OpenRouter API key at rest in the DB.
# When unset, a persistent 0600 key file is generated at <DATA_DIR>/.secret-key.
# Changing it orphans previously encrypted keys (re-enter the API key after).
INTERVIEWHUB_SECRET=
# APP_PASSWORD: when set, the app requires a password login (7-day session
# cookie) and refuses remote (non-localhost) access without it. When unset,
# the app is local-only: any non-localhost request gets 403.
APP_PASSWORD=
# INTERVIEWHUB_USE_KEYCHAIN: on macOS only, set to 1 to store the OpenRouter
# key in the macOS Keychain (service InterviewHub, account openrouter) instead
# of the encrypted DB column. Default (unset/0) is the file-encrypted DB store.
INTERVIEWHUB_USE_KEYCHAIN=
# TRUST_PROXY: set to 1 only when a trusted reverse proxy sits in front and
# you want rate limiting / login throttling to use the first X-Forwarded-For
# entry. Otherwise the socket remote address is used (X-Forwarded-For is
# ignored, since clients can forge it).
TRUST_PROXY=
